# Copy to local.properties (gitignored) and fill in. Never commit the real file.
#
# sdk.dir is written by Android Studio; set it by hand for a headless build.
sdk.dir=/path/to/Android/sdk

# Optional: prefills the login screen on debug builds and feeds scripts/capture-api.sh.
# Release builds never see these.
lugu.dev.serverUrl=https://your-server.example
lugu.dev.user=you
lugu.dev.pass=

# Optional: what the instrumented playback tests may touch on that server. Separate from
# the credentials because having a server is not the same as agreeing that a test may play
# something on it. The first is a book title; the second is a series with at least two
# numbered volumes, whose positions the next-in-series test overwrites.
# `scripts/seed-test-server.sh` prints values for both.
lugu.test.playQuery=
lugu.test.seriesQuery=

# Optional: Sentry ingest key for a local release build. CI injects this instead.
# Maintainer copy: `sops -d secrets.enc.yaml`. Leave empty and crash reporting
# simply cannot start — which is the right default for a fork or a contributor.
lugu.sentry.dsn=
