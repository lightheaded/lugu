<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!--
      `MissingMediaBrowserServiceIntentFilter` is a false positive here. The check reads
      this file, and `LuguPlaybackService` is declared in `:playback` — where it already
      advertises `android.media.browse.MediaBrowserService`. The merged manifest that
      ships in the APK carries the action; verify with
      `app/build/intermediates/merged_manifest/*/AndroidManifest.xml` before removing
      this. Suppressed here rather than disabled project-wide so it still applies to any
      service declared in this module.
    -->
    <application
        android:name=".LuguApplication"
        tools:ignore="MissingMediaBrowserServiceIntentFilter"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Lugu">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.Lugu">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              "Play the dark forest on lugu", said out loud. Assistant delivers a spoken
              request here rather than through the media session, so without this filter
              a voice request opens the app and stops — which in a car is the same as
              nothing happening.
            -->
            <intent-filter>
                <action android:name="android.media.action.MEDIA_PLAY_FROM_SEARCH" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!--
            Nothing about crash reporting starts on its own. The SDK is initialised by
            CrashReporting only after consent, so a build nobody has opted into never
            loads it at all. Setting `enabled = false` at init instead would still run
            its instrumentation, which is not what the README promises.
        -->
        <meta-data
            android:name="io.sentry.auto-init"
            android:value="false" />

        <!--
          Android Auto looks for this before it will show lugu in a car at all. The
          playback service already advertises the legacy browser action alongside the
          Media3 ones, which is the other half of being visible there.
        -->
        <meta-data
            android:name="com.google.android.gms.car.application"
            android:resource="@xml/automotive_app_desc" />

        <!-- Hilt supplies the worker factory; the default initialiser must stand down. -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>
    </application>
</manifest>
