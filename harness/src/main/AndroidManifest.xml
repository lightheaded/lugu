<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!--
      An application with almost no code in it. It exists so that the instrumented tests
      beside it have a package of their own to run in — one that survives `am force-stop` on
      lugu. There is no activity and no receiver here on purpose: anything this app did would
      be a second thing to explain when a test failed.
    -->

    <!--
      Package visibility. Without this the harness cannot address a broadcast to lugu at
      all on Android 11 and later: the intent resolves to nothing and the call returns
      quietly, which looks exactly like lugu ignoring the command. Only lugu's debug
      application id is named, so this grants no wider view of the device.
    -->
    <queries>
        <package android:name="io.github.lightheaded.lugu.debug" />
    </queries>

    <!--
      No icon, because there is nothing to launch: this app has no activity and never
      appears anywhere a person would look for one. `allowBackup` is left unset for the
      same reason — it holds no data to back up, and setting it would only bring the
      Android 12 data-extraction-rules warning with it.
    -->
    <application
        android:label="lugu harness"
        tools:ignore="MissingApplicationIcon">

        <!--
          The one component the harness has, and the platform is the reason it exists here.
          Before it opens a tunnel, the platform resolves the class that asked for it and
          refuses any class that is not declared with BIND_VPN_SERVICE. So this declaration
          is part of the mechanism: without it, `establish()` throws instead of taking lugu
          offline. The permission means only the system can bind it. See OfflineVpnService
          for why the offline check cuts one package rather than turning airplane mode on.
        -->
        <service
            android:name=".OfflineVpnService"
            android:exported="true"
            android:permission="android.permission.BIND_VPN_SERVICE">
            <intent-filter>
                <action android:name="android.net.VpnService" />
            </intent-filter>
        </service>
    </application>
</manifest>
